# Copia este archivo como `.env` en esta misma carpeta (server/) y ajusta los valores.

# ---------- Base de datos (PostgreSQL) ----------
# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:CAMBIAR@localhost:5432/MilimetroDSegundo?schema=public"

# ---------- API ----------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---------- Autenticación ----------
# Cadena larga y aleatoria. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO
# Minutos sin actividad antes de cerrar la sesión, y aviso previo
SESSION_IDLE_MINUTES=60
SESSION_WARNING_MINUTES=5

# ---------- Archivos ----------
UPLOADS_DIR=./storage/uploads
REPORTS_DIR=./storage/reports
MAX_IMAGE_MB=5
